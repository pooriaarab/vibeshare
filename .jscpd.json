{
  "min-tokens": 100,
  "threshold": 5,
  "mode": "mild",
  "format": ["typescript", "tsx"],
  "ignore": [
    "**/__tests__/**",
    "**/tests/**",
    "**/*.{test,spec}.{ts,tsx}",
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/vendor/**"
  ]
}
